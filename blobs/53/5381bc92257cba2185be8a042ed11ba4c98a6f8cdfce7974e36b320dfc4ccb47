",Lt("Ōike Park's path is exactly two kilometres around the lake. It is perfect for evening runs."));Pt("fukuoka_dialect",Lt(`In Tsurumi dialect, "すいとーよ" means "I like you". It sounds sweeter than the standard way, doesn't it?`,"「ありがとう」 becomes 「ありがとー」 here, soft and warm."));Pt("fukuoka_fisher",Lt("The mentaiko you see in every shop is spicy cod roe. It is eaten on rice, in onigiri and even in pasta."));Pt("dazaifu_guide",Lt("Welcome to Gakumon Shrine. It honours Sugawara no Michizane, the god of learning.","Students come here to pray before exams. A good place for a language learner too."));Pt("dazaifu_student",Lt("I touched the bronze ox for luck. It is shiny from everyone's hands. Wish me luck on my exam!"));Pt("dazaifu_priest",Lt("The plum trees here bloom in late winter. Their scent is said to carry the prayers of students."));Pt("sign_dazaifu",Lt("学問神社 — Gakumon Shrine. Please pass under the torii and bow before entering."));const zi=(d,c="closed_shop")=>({dx:d,closed:c});function ei(d,c,g,w,S,M=3){let h=w;for(const x of S)d.building({id:x.id,x:h,y:c,w:x.w,h:g,style:x.style,facade:x.facade??M,sign:x.sign,signEn:x.signEn,accent:x.accent,palette:x.palette,extraTop:x.extraTop,door:zi(x.dx??Math.floor(x.w/2),x.closed)}),h+=x.w;return h}const oo=(d,c,g,w,S,M,h,x,t,i=0)=>{d.building({id:c,x:g,y:0,w,h:6,style:S,facade:4,extraTop:i,sign:M,signEn:h,door:{dx:Math.floor(w/2)-1,to:{map:x,spawn:"entrance"},label:t}})};function ho(d,c,g){d.fill(0,6,c,3,"plaza").fill(0,9,c,1,"pave").fill(0,10,c,3,"road").fill(0,13,c,1,"pave"),d.fill(g,10,3,3,"zebraV"),d.decal("centerLine",0,11,g).decal("centerLine",g+3,11,c-g-3),d.decal("stopLine",g-2,10,1,3).decal("stopLine",g+4,10,1,3),d.decal("manhole",8,11).decal("manhole",c-12,10).decal("drain",6,12).decal("drain",c-8,12),d.decal("busStop",2,8)}function J0(){const g=new ni({id:"nara",name:"Shikamori",nameJp:"鹿森",city:"nara",kind:"exterior",w:48,h:36,music:"kyoto",ambience:"kyoto",district:"kyoto",wires:!0},"pave");ho(g,48,20),g.fill(21